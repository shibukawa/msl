# Step17 trial profile: start from legacy-defconfig baseline and prune broad
# optional device families first, while keeping msl-required virtio/runtime keys.

# Keep runtime-critical virtio path explicit.
CONFIG_MODULES=n
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_FS=y
CONFIG_NET_VENDOR_VIRTIO=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_RING=y 
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LIB=y

# Device Tree
CONFIG_OF=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_IRQ_DOMAIN=y

# First pruning pass: display/media off. Keep minimal virtio sound.
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_VIRTIO=y

# Serial
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_HVC_DRIVER=y
CONFIG_HVC_CONSOLE=y
CONFIG_TTY=y
CONFIG_DEVTMPFS=y
CONFIG_SERIAL_EARLYCON=y

# Next pruning pass: remove full wireless/mobile stacks.
CONFIG_WIRELESS=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n
CONFIG_BT=n
CONFIG_NFC=n
CONFIG_WWAN=n
CONFIG_QRTR=n
CONFIG_MHI_BUS=n

# Next pruning pass: remove USB network/serial driver families.
CONFIG_USB_SUPPORT=n
CONFIG_USB=n
CONFIG_USB_USBNET=n
CONFIG_USB_NET_DRIVERS=n
CONFIG_USB_SERIAL=n

# Next pruning pass: remove SCSI/RAID/DM stacks.
CONFIG_SCSI=n
CONFIG_BLK_DEV_MD=n
CONFIG_BLK_DEV_DM=n

# Next pruning pass: remove non-essential filesystem families.
CONFIG_BTRFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_XFS_FS=n
CONFIG_NTFS3_FS=n
CONFIG_UBIFS_FS=n
CONFIG_SQUASHFS=n
CONFIG_EROFS_FS=y
CONFIG_NET_9P=n
CONFIG_9P_FS=n
CONFIG_9P_FSCACHE=n

# Next pruning pass: remove input/hid/touch stacks.
CONFIG_INPUT=n
CONFIG_HID=n
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_KEYBOARD=n
CONFIG_INPUT_TOUCHSCREEN=n

